{{ 'suppz-featured-deals.css' | asset_url | stylesheet_tag }}
{{ 'suppz-wellness-slider.css' | asset_url | stylesheet_tag }}
<script src="{{ 'suppz-featured-deals.js' | asset_url }}" defer></script>
<section class="sn-wellness" aria-labelledby="SNWellness-{{ section.id }}" style="--sn-wellness-zoom:{{ section.settings.hover_zoom | divided_by: 100.0 }};--sn-wellness-bg:{{ section.settings.background }};--sn-wellness-top:{{ section.settings.padding_top }}px;--sn-wellness-bottom:{{ section.settings.padding_bottom }}px;">
  <div class="sn-wellness__heading">
    <h2 id="SNWellness-{{ section.id }}">{{ section.settings.title | escape }}</h2>
    {% if section.settings.description != blank %}<p>{{ section.settings.description | escape }}</p>{% endif %}
  </div>
  <suppz-deal-slider class="sn-deals sn-wellness__slider" aria-label="Wellness categories">
    <div class="sn-deals__slider">
      <div class="sn-deals__track" id="SNWellnessTrack-{{ section.id }}" role="region" tabindex="0" aria-label="Wellness cards. Swipe, drag or use arrow keys to browse.">
        <ul class="sn-deals__list" role="list">
          {% for block in section.blocks %}
            <li class="sn-deals__card sn-wellness__card" {{ block.shopify_attributes }}>
              {% assign destination = block.settings.link | default: block.settings.collection.url | default: routes.all_products_collection_url %}
              <a class="sn-wellness__link" href="{{ destination }}" draggable="false" aria-label="{{ block.settings.title | escape }}">
                {% if block.settings.image != blank %}
                  {{ block.settings.image | image_url: width: 1000 | image_tag: widths: '300, 450, 650, 1000', sizes: '(max-width: 749px) 78vw, 330px', loading: 'lazy', alt: '', class: 'sn-wellness__image' }}
                {% else %}{{ 'lifestyle-1' | placeholder_svg_tag: 'sn-wellness__image sn-wellness__placeholder' }}{% endif %}
                <div class="sn-wellness__text"><h3>{{ block.settings.title | escape }}</h3>{% if block.settings.subtitle != blank %}<p>{{ block.settings.subtitle | escape }}</p>{% endif %}</div>
              </a>
            </li>
          {% endfor %}
        </ul>
      </div>
      <button class="sn-deals__arrow sn-deals__arrow--prev" type="button" data-prev aria-label="Previous wellness cards" aria-controls="SNWellnessTrack-{{ section.id }}" disabled><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M19 12H5m6-6-6 6 6 6"/></svg></button>
      <button class="sn-deals__arrow sn-deals__arrow--next" type="button" data-next aria-label="Next wellness cards" aria-controls="SNWellnessTrack-{{ section.id }}"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14m-6-6 6 6-6 6"/></svg></button>
    </div>
  </suppz-deal-slider>
</section>
{% schema %}
{
 "name":"Wellness Image Slider","tag":"section","class":"sn-wellness-section","max_blocks":16,
 "disabled_on":{"groups":["header","footer"]},
 "settings":[
  {"type":"text","id":"title","label":"Heading","default":"EXPLORE WELLNESS SUPPORT THAT FITS YOUR GOALS"},
  {"type":"textarea","id":"description","label":"Description","default":"From sleep and stress relief through to gut health, immunity and focus, shop the goal that is most important to you."},
  {"type":"range","id":"hover_zoom","label":"Image zoom on hover","min":100,"max":115,"step":1,"unit":"%","default":105},
  {"type":"color","id":"background","label":"Background","default":"#ffffff"},
  {"type":"range","id":"padding_top","label":"Top spacing","min":0,"max":100,"step":4,"unit":"px","default":28},
  {"type":"range","id":"padding_bottom","label":"Bottom spacing","min":0,"max":100,"step":4,"unit":"px","default":28}
 ],
 "blocks":[{"type":"wellness_card","name":"Wellness card","settings":[
  {"type":"image_picker","id":"image","label":"Image","info":"Recommended portrait image: 660 × 1000 px."},
  {"type":"text","id":"title","label":"Title","default":"SLEEP SUPPORT"},
  {"type":"text","id":"subtitle","label":"Subtitle","default":"EVENING SUPPORT FOR RESTFUL NIGHTS"},
  {"type":"collection","id":"collection","label":"Collection"},
  {"type":"url","id":"link","label":"Custom link (overrides collection)"}
 ]}],
 "presets":[{"name":"Wellness Image Slider","blocks":[
  {"type":"wellness_card","settings":{"title":"SLEEP SUPPORT","subtitle":"EVENING SUPPORT FOR RESTFUL NIGHTS"}},
  {"type":"wellness_card","settings":{"title":"STRESS RELIEF","subtitle":"CALM SUPPORT FOR BUSY DAYS"}},
  {"type":"wellness_card","settings":{"title":"GUT HEALTH","subtitle":"DAILY SUPPORT FOR DIGESTIVE HEALTH"}},
  {"type":"wellness_card","settings":{"title":"IMMUNITY SUPPORT","subtitle":"EVERYDAY SUPPORT FOR IMMUNE HEALTH"}},
  {"type":"wellness_card","settings":{"title":"ENERGY & FOCUS","subtitle":"DAILY SUPPORT FOR ENERGY AND CLARITY"}},
  {"type":"wellness_card","settings":{"title":"RECOVERY","subtitle":"SUPPORT FOR YOUR POST-WORKOUT ROUTINE"}}
 ]}]
}
{% endschema %}
