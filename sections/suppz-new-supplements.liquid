{{ 'suppz-featured-deals.css' | asset_url | stylesheet_tag }}
{{ 'suppz-tabbed-collection.css' | asset_url | stylesheet_tag }}
{{ 'suppz-new-supplements.css' | asset_url | stylesheet_tag }}
{{ 'quick-add.css' | asset_url | stylesheet_tag }}
<script src="{{ 'suppz-featured-deals.js' | asset_url }}" defer></script>
<script src="{{ 'product-form.js' | asset_url }}" defer></script>
<script src="{{ 'quick-add.js' | asset_url }}" defer></script>
<section class="sn-tabs sn-new" aria-labelledby="SNNew-{{ section.id }}" style="--sn-tabs-accent:{{ section.settings.accent }};--sn-tabs-top:{{ section.settings.padding_top }}px;--sn-tabs-bottom:{{ section.settings.padding_bottom }}px;">
  <h2 class="sn-tabs__heading" id="SNNew-{{ section.id }}">{{ section.settings.title | escape }}</h2>
  <div class="sn-tabs__toolbar sn-new__toolbar">
    {% if section.settings.label != blank %}<span class="sn-new__label">{{ section.settings.label | escape }}</span>{% endif %}
    {% if section.settings.show_view_all %}<a class="sn-tabs__view-all" href="{{ section.settings.collection.url | default: routes.all_products_collection_url }}">{{ section.settings.view_all_label | escape }}</a>{% endif %}
  </div>
  <suppz-deal-slider class="sn-deals sn-tabs__products" aria-label="New supplements products">
    <div class="sn-deals__slider">
      <div class="sn-deals__track" id="SNNewTrack-{{ section.id }}" tabindex="0" role="region" aria-label="New supplements. Swipe, drag or use arrow keys to browse.">
        <ul class="sn-deals__list" role="list">
          {% for product in section.settings.collection.products limit: section.settings.products_to_show %}
            {% render 'suppz-tabbed-product', product: product, section: section, tab_id: 'new-arrivals', show_new_badge: section.settings.show_new_badge %}
          {% else %}
            {% if section.settings.collection == blank %}
              {% for i in (1..6) %}{% render 'suppz-tabbed-product', section: section %}{% endfor %}
            {% else %}<li class="sn-deals__empty">{{ 'sections.collection_template.empty' | t }}</li>{% endif %}
          {% endfor %}
        </ul>
      </div>
      <button class="sn-deals__arrow sn-deals__arrow--prev" type="button" data-prev aria-label="Previous new products" aria-controls="SNNewTrack-{{ section.id }}" disabled><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M19 12H5m6-6-6 6 6 6"/></svg></button>
      <button class="sn-deals__arrow sn-deals__arrow--next" type="button" data-next aria-label="Next new products" aria-controls="SNNewTrack-{{ section.id }}"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14m-6-6 6 6-6 6"/></svg></button>
    </div>
  </suppz-deal-slider>
</section>
{% schema %}
{
 "name":"New Supplements","tag":"section","class":"sn-new-section",
 "disabled_on":{"groups":["header","footer"]},
 "settings":[
  {"type":"text","id":"title","label":"Heading","default":"NEW SUPPLEMENTS"},
  {"type":"text","id":"label","label":"Collection label","default":"NEW ARRIVALS"},
  {"type":"collection","id":"collection","label":"Collection","info":"Products use the collection's sort order. Set the collection to Newest in Shopify for new arrivals."},
  {"type":"range","id":"products_to_show","label":"Products to show","min":4,"max":24,"step":1,"default":12},
  {"type":"checkbox","id":"show_view_all","label":"Show View All","default":true},
  {"type":"text","id":"view_all_label","label":"View All label","default":"VIEW ALL"},
  {"type":"checkbox","id":"show_new_badge","label":"Show NEW badge on selected products","default":true},
  {"type":"text","id":"new_badge_label","label":"Badge label","default":"NEW"},
  {"type":"checkbox","id":"show_compare_price","label":"Show original price for sale products","default":true},
  {"type":"color","id":"accent","label":"Button color","default":"#ed142b"},
  {"type":"range","id":"padding_top","label":"Top spacing","min":0,"max":100,"step":4,"unit":"px","default":28},
  {"type":"range","id":"padding_bottom","label":"Bottom spacing","min":0,"max":100,"step":4,"unit":"px","default":28}
 ],
 "presets":[{"name":"New Supplements"}]
}
{% endschema %}
