{{ 'suppz-article-cards.css' | asset_url | stylesheet_tag }}
<section class="sn-articles" aria-label="{{ section.settings.title | default: 'Latest articles' | escape }}" style="--sn-articles-top:{{ section.settings.padding_top }}px;--sn-articles-bottom:{{ section.settings.padding_bottom }}px;">
  {% if section.settings.show_heading %}<h2 class="sn-articles__heading">{{ section.settings.title | escape }}</h2>{% endif %}
  <div class="sn-articles__grid">
    {% if section.settings.source == 'manual' %}
      {% for block in section.blocks %}{% render 'suppz-article-card', article: block.settings.article, block: block, section: section %}{% endfor %}
    {% else %}
      {% for article in section.settings.blog.articles limit: section.settings.post_limit %}{% render 'suppz-article-card', article: article, section: section %}
      {% else %}{% for i in (1..3) %}{% render 'suppz-article-card', section: section %}{% endfor %}{% endfor %}
    {% endif %}
  </div>
</section>
{% schema %}
{
 "name":"Article Cards","tag":"section","class":"sn-article-cards-section","max_blocks":6,
 "disabled_on":{"groups":["header","footer"]},
 "settings":[
  {"type":"text","id":"title","label":"Section heading","default":"FIT TALK"},
  {"type":"checkbox","id":"show_heading","label":"Show section heading","default":false},
  {"type":"select","id":"source","label":"Article source","default":"blog","options":[{"value":"blog","label":"Latest articles from a blog"},{"value":"manual","label":"Choose cards individually"}]},
  {"type":"blog","id":"blog","label":"Blog"},
  {"type":"range","id":"post_limit","label":"Number of blog articles","min":3,"max":6,"step":1,"default":3},
  {"type":"range","id":"padding_top","label":"Top spacing","min":0,"max":100,"step":4,"unit":"px","default":28},
  {"type":"range","id":"padding_bottom","label":"Bottom spacing","min":0,"max":100,"step":4,"unit":"px","default":28}
 ],
 "blocks":[{"type":"article_card","name":"Article card","settings":[
  {"type":"article","id":"article","label":"Article"},
  {"type":"image_picker","id":"image","label":"Custom image (optional)"},
  {"type":"text","id":"category","label":"Category badge (optional)"},
  {"type":"text","id":"title","label":"Custom title (optional)"},
  {"type":"textarea","id":"excerpt","label":"Custom description (optional)"},
  {"type":"range","id":"reading_time","label":"Reading time (0 = automatic)","min":0,"max":30,"step":1,"unit":"min","default":0},
  {"type":"url","id":"link","label":"Custom article link (optional)"}
 ]}],
 "presets":[{"name":"Article Cards","blocks":[{"type":"article_card"},{"type":"article_card"},{"type":"article_card"}]}]
}
{% endschema %}
