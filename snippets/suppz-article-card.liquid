{% liquid
  assign card_image = block.settings.image | default: article.image
  assign card_title = block.settings.title | default: article.title | default: 'Article title'
  assign card_excerpt = block.settings.excerpt | default: article.excerpt_or_content | strip_html | strip | truncate: 170
  assign card_category = block.settings.category | default: article.tags.first | default: section.settings.blog.title | default: 'FIT TALK'
  assign card_url = block.settings.link | default: article.url
  assign reading_time = block.settings.reading_time | default: 0
  if reading_time == 0 and article != blank
    assign word_count = article.content | strip_html | split: ' ' | size
    assign reading_time = word_count | divided_by: 200.0 | ceil | at_least: 1
  endif
%}
<article class="sn-articles__card"{% if block != blank %} {{ block.shopify_attributes }}{% endif %}>
  {% if card_url != blank %}<a class="sn-articles__link" href="{{ card_url }}" aria-label="{{ card_title | escape }}">{% else %}<div class="sn-articles__link">{% endif %}
    <div class="sn-articles__media">
      {% if card_image != blank %}{{ card_image | image_url: width: 1200 | image_tag: widths: '400, 600, 800, 1200', sizes: '(min-width: 1456px) 450px, (min-width: 990px) 32vw, (min-width: 750px) 48vw, calc(100vw - 30px)', loading: 'lazy', alt: '', class: 'sn-articles__image' }}
      {% else %}{{ 'lifestyle-1' | placeholder_svg_tag: 'sn-articles__image sn-articles__placeholder' }}{% endif %}
      <span class="sn-articles__category">{{ card_category | escape }}</span>
    </div>
    <div class="sn-articles__body">
      {% if reading_time > 0 %}<p class="sn-articles__time">Reading time <span aria-hidden="true">•</span> {{ reading_time }} {% if reading_time == 1 %}min{% else %}mins{% endif %}</p>{% endif %}
      <h3>{{ card_title | escape }}</h3>
      {% if card_excerpt != blank %}<p class="sn-articles__excerpt">{{ card_excerpt | escape }}</p>{% elsif request.design_mode %}<p class="sn-articles__excerpt">Select a blog or choose an article for this card.</p>{% endif %}
    </div>
    <div class="sn-articles__footer" aria-hidden="true"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"><path d="M7 17 17 7M7 7h10v10"/></svg></div>
  {% if card_url != blank %}</a>{% else %}</div>{% endif %}
</article>
